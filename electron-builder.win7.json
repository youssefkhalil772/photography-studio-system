{
  "appId": "com.deltatech.studiopro",
  "productName": "StudioPro",
  "electronVersion": "22.3.27",
  "asar": true,
  "compression": "maximum",
  "files": [
    "**/*",
    "!.git{,/**}",
    "!.gitignore",
    "!.install.id",
    "!testData{,/**}",
    "!**/*.md",
    "!dist{,/**}",
    "!dist-win7{,/**}",
    "!.wwebjs_cache{,/**}",
    "!**/*.map",
    "!node_modules/.cache{,/**}",
    "!scripts{,/**}",
    "!bin{,/**}",
    "!*.png",
    "!*.bat",
    "!show-ids.js",
    "!test-db.js",
    "!test.js",
    "!replace_dates.js",
    "!list-tables.js",
    "!package-lock.json",
    "!electron-builder.win7.json",
    "!node_modules/**/test{,/**}",
    "!node_modules/**/tests{,/**}",
    "!node_modules/**/example{,/**}",
    "!node_modules/**/examples{,/**}",
    "!node_modules/**/docs{,/**}",
    "!node_modules/**/*.ts",
    "!node_modules/better-sqlite3/src{,/**}",
    "!node_modules/better-sqlite3/deps{,/**}",
    "!node_modules/better-sqlite3/build/Release/obj{,/**}"
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "StudioPro",
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "differentialPackage": false
  },
  "directories": {
    "output": "dist-win7"
  }
}
