{
  "name": "photography-studio-system",
  "version": "1.0.0",
  "description": "نظام إدارة استوديو التصوير - Photography Studio System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win7": "electron-builder --config electron-builder.win7.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "sweetalert2": "^11.26.25",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "author": "Dev Blue Tech",
  "license": "MIT",
  "build": {
    "appId": "com.deltatech.studiopro",
    "productName": "StudioPro",
    "asar": true,
    "compression": "maximum",
    "files": [
      "**/*",
      "!.git{,/**}",
      "!.gitignore",
      "!.install.id",
      "!testData{,/**}",
      "!**/*.md",
      "!dist{,/**}",
      "!dist-win7{,/**}",
      "!.wwebjs_cache{,/**}",
      "!**/*.map",
      "!node_modules/.cache{,/**}",
      "!scripts{,/**}",
      "!bin{,/**}",
      "!list-tables.js",
      "!electron-builder.win7.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudioPro",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
